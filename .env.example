# =============================================================================
# ASL Connect — Environment Variables (Example)
# =============================================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control. This example file is safe to commit.

# Django secret key used for cryptographic signing (sessions, CSRF, tokens).
# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode. Set to False in production.
# When True, Django shows detailed error pages and serves static files directly.
# DJANGO_DEBUG=True

# Comma-separated list of allowed host/domain names.
# In production, replace with your actual domain(s).
# Example: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Database Configuration (optional — uncomment and adjust for PostgreSQL)
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=asl_connect
# DB_USER=asl_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Channel Layer (optional — uncomment for production WebSocket support)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Email Configuration (optional — uncomment to enable email sending)
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ASL Connect <noreply@yourdomain.com>
